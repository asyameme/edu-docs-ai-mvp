        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "parsed": {
          "$ref": "#/$defs/ParserOutput"
        },
        "original_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Url"
        }
      },
      "required": [
        "document_id",
        "sha256",
        "parsed"
      ],
      "title": "AnalysisDocument",
      "type": "object"
    },
    "AnalysisV1": {
      "additionalProperties": false,
