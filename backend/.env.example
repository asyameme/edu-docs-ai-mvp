# Только для локальной разработки. Скопируйте в .env и задайте свои пароли.
POSTGRES_PASSWORD=replace-with-local-password
FRONTEND_PORT=8080
API_PORT=8000
TEMPORAL_DB_PASSWORD=replace-with-a-different-local-password
MAX_UPLOAD_BYTES=524288000
PARSER_URL=
ANALYSIS_URL=
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_ENABLED=false
# Ключ получает только Worker; Compose передаёт API лишь признак его наличия.
CHAT_API_KEY=
CHAT_MAX_TURNS=8
CHAT_MODEL_TIMEOUT_SECONDS=45
TEMPORAL_UI_PORT=8233
