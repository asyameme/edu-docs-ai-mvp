{
  "$defs": {
    "CharacteristicMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "doc_type": {
          "const": "CHARACTERISTIC",
          "default": "CHARACTERISTIC",
          "title": "Doc Type",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "title": "File Hash",
          "type": "string"
        },
        "parser_config": {
          "title": "Parser Config",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program Id"
        }
      },
      "required": [
        "file_name",
        "file_hash",
        "parser_config"
      ],
      "title": "CharacteristicMeta",
      "type": "object"
    },
    "Competency": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "formulation": {
          "title": "Formulation",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "code",
        "formulation"
      ],
      "title": "Competency",
      "type": "object"
    },
    "ParseIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "not_found",
            "unparsed_row",
            "empty_cell",
            "unexpected_format",
            "ambiguous",
            "manual_review"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ParseIssue",
      "type": "object"
    },
    "ProgramV2": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "бакалавриат",
                "магистратура",
                "специалитет",
                "аспирантура"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "direction_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction Code"
        },
        "education_standard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Education Standard"
        },
        "professional_standards": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Professional Standards",
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "study_duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Duration"
        },
        "study_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Form"
        },
        "education_languages": {
          "items": {
            "type": "string"
          },
          "title": "Education Languages",
          "type": "array"
        },
        "program_cipher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program Cipher"
        }
      },
      "required": [
        "source_ref"
      ],
      "title": "ProgramV2",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Указатель на место в исходном DOCX; текст фрагмента хранится отдельно.\n\nparagraph_index нумеруется с 1 по порядку абзацев тела документа, включая\nабзацы в таблицах, без колонтитулов и сносок. table/row/col также нумеруются\nс 1; row=1 — шапка таблицы. Указатель относится к версии файла, связанной\nс записью парсера.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "table": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        }
      },
      "required": [
        "file"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceRefV2": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "table": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        },
        "sheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        }
      },
      "required": [
        "file"
      ],
      "title": "SourceRefV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/CharacteristicMeta"
    },
    "program": {
      "$ref": "#/$defs/ProgramV2"
    },
    "competencies": {
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "title": "Competencies",
      "type": "array"
    },
    "parse_issues": {
      "items": {
        "$ref": "#/$defs/ParseIssue"
      },
      "title": "Parse Issues",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "program"
  ],
  "title": "CharacteristicOutput",
  "type": "object"
}
