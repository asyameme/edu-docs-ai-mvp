        "description"
      ],
      "title": "PracticeStage",
      "type": "object"
    },
    "RPPMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "doc_type": {
          "const": "RPP",
          "default": "RPP",
          "title": "Doc Type",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "title": "File Hash",
          "type": "string"
        },
        "parser_config": {
          "title": "Parser Config",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program Id"
        }
      },
      "required": [
        "file_name",
        "file_hash",
        "parser_config"
      ],
      "title": "RPPMeta",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "description": "Связь между сущностями. Ссылка на сущность — по естественному ключу:\ndiscipline/curriculum_item/course_topic — название, остальные — код.",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "src_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Src Entity",
          "type": "string"
        },
        "src_key": {
          "title": "Src Key",
          "type": "string"
        },
        "dst_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Dst Entity",
          "type": "string"
        },
        "dst_key": {
          "title": "Dst Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "формирует",
            "имеет",
            "проверяется",
            "включает"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "src_entity",
        "src_key",
        "dst_entity",
        "dst_key",
        "kind"
      ],
      "title": "Relation",
      "type": "object"
    },
