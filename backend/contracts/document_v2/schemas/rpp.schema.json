          "$ref": "#/$defs/SourceRef"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "task_examples": {
          "items": {
            "type": "string"
          },
          "title": "Task Examples",
          "type": "array"
        }
      },
      "required": [
        "source_ref",
        "name"
      ],
      "title": "AssessmentToolV2",
      "type": "object"
    },
    "Competency": {
