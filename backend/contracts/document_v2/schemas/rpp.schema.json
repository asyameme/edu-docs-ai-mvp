        "source_ref",
        "code",
        "formulation"
      ],
      "title": "Competency",
      "type": "object"
    },
    "CourseTopic": {
      "additionalProperties": false,
      "description": "Строка таблицы «Структура и содержание»: тема × вид занятий × часы.",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "activity": {
          "title": "Activity",
          "type": "string"
        },
        "hours": {
          "minimum": 0,
          "title": "Hours",
          "type": "integer"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        }
      },
      "required": [
        "source_ref",
        "topic",
        "activity",
        "hours"
      ],
      "title": "CourseTopic",
      "type": "object"
    },
    "Discipline": {
      "additionalProperties": false,
      "properties": {
