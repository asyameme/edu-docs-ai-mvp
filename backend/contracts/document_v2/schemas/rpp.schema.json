    "LearningOutcome": {
      "additionalProperties": false,
      "description": "Результат обучения «знать/уметь/владеть».\n\nlocal_id назначает парсер (уникален в файле, «LO-001») — ключ для связей:\nв источнике у результатов кода нет, кроме вариантов вида «ПКП-УНК-03.01. У-1».\nkind=None — тип результата не удалось определить по данным источника.",
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "local_id": {
          "title": "Local Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "знать",
                "уметь",
                "владеть"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        }
      },
      "required": [
        "source_ref",
        "local_id",
        "text"
      ],
      "title": "LearningOutcome",
      "type": "object"
    },
    "ParseIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "not_found",
            "unparsed_row",
            "empty_cell",
            "unexpected_format",
            "ambiguous",
            "manual_review"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ParseIssue",
      "type": "object"
    },
    "PracticeStage": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "semester": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
