        },
        "hours_total": {
          "minimum": 0,
          "title": "Hours Total",
          "type": "integer"
        },
        "hours_by_kind": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hours By Kind",
          "type": "object"
