{
  "$defs": {
    "Competency": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "formulation": {
          "title": "Formulation",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "code",
        "formulation"
      ],
      "title": "Competency",
      "type": "object"
    },
    "CurriculumItem": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "discipline_name": {
          "title": "Discipline Name",
          "type": "string"
        },
        "semester": {
          "maximum": 8,
          "minimum": 1,
          "title": "Semester",
          "type": "integer"
        },
        "credit_units": {
          "minimum": 1,
          "title": "Credit Units",
          "type": "integer"
        },
        "hours_total": {
          "minimum": 0,
          "title": "Hours Total",
          "type": "integer"
        },
        "block": {
          "title": "Block",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "discipline_name",
        "semester",
        "credit_units",
        "hours_total",
        "block"
      ],
      "title": "CurriculumItem",
      "type": "object"
    },
    "CurriculumMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "doc_type": {
          "const": "CURRICULUM",
          "default": "CURRICULUM",
          "title": "Doc Type",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "title": "File Hash",
          "type": "string"
        },
        "parser_config": {
          "title": "Parser Config",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program Id"
        }
      },
      "required": [
        "file_name",
        "file_hash",
        "parser_config"
      ],
      "title": "CurriculumMeta",
      "type": "object"
    },
    "ParseIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "not_found",
            "unparsed_row",
            "empty_cell",
            "unexpected_format",
            "ambiguous",
            "manual_review"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRefV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ParseIssue",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "src_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Src Entity",
          "type": "string"
        },
        "src_key": {
          "title": "Src Key",
          "type": "string"
        },
        "dst_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Dst Entity",
          "type": "string"
        },
        "dst_key": {
          "title": "Dst Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "формирует",
            "имеет",
            "проверяется",
            "включает"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "src_entity",
        "src_key",
        "dst_entity",
        "dst_key",
        "kind"
      ],
      "title": "Relation",
      "type": "object"
    },
    "SourceRefV2": {
      "additionalProperties": false,
      "description": "Координаты значения в исходном DOCX или XLSX.\n\nparagraph_index считает абзацы тела DOCX с 1, включая таблицы и исключая\nколонтитулы и сноски. Номера table, row и col также начинаются с 1;\nrow=1 обозначает заголовок таблицы. Для XLSX используются sheet_name и cell.\nТекст фрагмента хранится отдельно от ссылки.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "table": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        },
        "sheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        }
      },
      "required": [
        "file"
      ],
      "title": "SourceRefV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/CurriculumMeta"
    },
    "competencies": {
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "title": "Competencies",
      "type": "array"
    },
    "curriculum_items": {
      "items": {
        "$ref": "#/$defs/CurriculumItem"
      },
      "title": "Curriculum Items",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "parse_issues": {
      "items": {
        "$ref": "#/$defs/ParseIssue"
      },
      "title": "Parse Issues",
      "type": "array"
    }
  },
  "required": [
    "meta"
  ],
  "title": "CurriculumOutput",
  "type": "object"
}
