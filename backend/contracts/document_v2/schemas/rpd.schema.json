{
  "$defs": {
    "AcademicHoursRange": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "range",
          "title": "Kind",
          "type": "string"
        },
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        },
        "unit": {
          "const": "academic_hour",
          "title": "Unit",
          "type": "string"
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "min",
        "max",
        "unit",
        "raw_text"
      ],
      "title": "AcademicHoursRange",
      "type": "object"
    },
    "AssessmentToolV2": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "task_examples": {
          "items": {
            "type": "string"
          },
          "title": "Task Examples",
          "type": "array"
        }
      },
      "required": [
        "source_ref",
        "name"
      ],
      "title": "AssessmentToolV2",
      "type": "object"
    },
    "Competency": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "formulation": {
          "title": "Formulation",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "code",
        "formulation"
      ],
      "title": "Competency",
      "type": "object"
    },
    "CourseTopic": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "activity": {
          "title": "Activity",
          "type": "string"
        },
        "hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/AcademicHoursRange"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hours"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        }
      },
      "required": [
        "source_ref",
        "topic",
        "activity",
        "hours"
      ],
      "title": "CourseTopic",
      "type": "object"
    },
    "Discipline": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "semesters": {
          "items": {
            "type": "integer"
          },
          "title": "Semesters",
          "type": "array"
        },
        "credit_units": {
          "anyOf": [
            {"minimum": 1, "type": "integer"},
            {"type": "null"}
          ],
          "title": "Credit Units"
        },
        "hours_total": {
          "anyOf": [
            {"minimum": 0, "type": "integer"},
            {"type": "null"}
          ],
          "title": "Hours Total"
        },
        "hours_by_kind": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hours By Kind",
          "type": "object"
        },
        "control_forms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Control Forms",
          "type": "array"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        }
      },
      "required": [
        "source_ref",
        "name",
        "semesters",
        "credit_units",
        "hours_total",
        "hours_by_kind"
      ],
      "title": "Discipline",
      "type": "object"
    },
    "DocumentSection": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "section_number": {
          "title": "Section Number",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "parent_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Section"
        }
      },
      "required": [
        "source_ref",
        "section_number",
        "title",
        "text"
      ],
      "title": "DocumentSection",
      "type": "object"
    },
    "Indicator": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "competency_code": {
          "title": "Competency Code",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "code",
        "text",
        "competency_code"
      ],
      "title": "Indicator",
      "type": "object"
    },
    "LearningOutcome": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "local_id": {
          "title": "Local Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "знать",
                "уметь",
                "владеть"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        }
      },
      "required": [
        "source_ref",
        "local_id",
        "text"
      ],
      "title": "LearningOutcome",
      "type": "object"
    },
    "ParseIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "not_found",
            "unparsed_row",
            "empty_cell",
            "unexpected_format",
            "ambiguous",
            "manual_review"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRefV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ParseIssue",
      "type": "object"
    },
    "RPDMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "doc_type": {
          "const": "RPD",
          "default": "RPD",
          "title": "Doc Type",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "title": "File Hash",
          "type": "string"
        },
        "parser_config": {
          "title": "Parser Config",
          "type": "string"
        },
        "program_id": {
          "title": "Program Id",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "file_hash",
        "parser_config",
        "program_id"
      ],
      "title": "RPDMeta",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "src_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Src Entity",
          "type": "string"
        },
        "src_key": {
          "title": "Src Key",
          "type": "string"
        },
        "dst_entity": {
          "enum": [
            "program",
            "discipline",
            "competency",
            "indicator",
            "learning_outcome",
            "assessment_tool",
            "curriculum_item",
            "course_topic"
          ],
          "title": "Dst Entity",
          "type": "string"
        },
        "dst_key": {
          "title": "Dst Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "формирует",
            "имеет",
            "проверяется",
            "включает"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "src_entity",
        "src_key",
        "dst_entity",
        "dst_key",
        "kind"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ScoreScaleItem": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/SourceRefV2"
        },
        "grade_spbu": {
          "title": "Grade Spbu",
          "type": "string"
        },
        "grade_ects": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Ects"
        },
        "points": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "criterion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion"
        }
      },
      "required": [
        "source_ref",
        "grade_spbu"
      ],
      "title": "ScoreScaleItem",
      "type": "object"
    },
    "SourceRefV2": {
      "additionalProperties": false,
      "description": "Координаты значения в исходном DOCX или XLSX.\n\nparagraph_index считает абзацы тела DOCX с 1, включая таблицы и исключая\nколонтитулы и сноски. Номера table, row и col также начинаются с 1;\nrow=1 обозначает заголовок таблицы. Для XLSX используются sheet_name и cell.\nТекст фрагмента хранится отдельно от ссылки.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "table": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        },
        "sheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        }
      },
      "required": [
        "file"
      ],
      "title": "SourceRefV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "education_languages": {
      "items": {
        "type": "string"
      },
      "title": "Education Languages",
      "type": "array"
    },
    "education_languages_source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRefV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "title_credit_units": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title Credit Units"
    },
    "title_credit_units_source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRefV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "$ref": "#/$defs/RPDMeta"
    },
    "disciplines": {
      "items": {
        "$ref": "#/$defs/Discipline"
      },
      "minItems": 1,
      "title": "Disciplines",
      "type": "array"
    },
    "competencies": {
      "items": {
        "$ref": "#/$defs/Competency"
      },
      "title": "Competencies",
      "type": "array"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Indicators",
      "type": "array"
    },
    "learning_outcomes": {
      "items": {
        "$ref": "#/$defs/LearningOutcome"
      },
      "title": "Learning Outcomes",
      "type": "array"
    },
    "assessment_tools": {
      "items": {
        "$ref": "#/$defs/AssessmentToolV2"
      },
      "title": "Assessment Tools",
      "type": "array"
    },
    "course_content": {
      "items": {
        "$ref": "#/$defs/CourseTopic"
      },
      "title": "Course Content",
      "type": "array"
    },
    "document_sections": {
      "items": {
        "$ref": "#/$defs/DocumentSection"
      },
      "title": "Document Sections",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "score_scale": {
      "items": {
        "$ref": "#/$defs/ScoreScaleItem"
      },
      "title": "Score Scale",
      "type": "array"
    },
    "parse_issues": {
      "items": {
        "$ref": "#/$defs/ParseIssue"
      },
      "title": "Parse Issues",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "disciplines"
  ],
  "title": "RPDOutput",
  "type": "object"
}
